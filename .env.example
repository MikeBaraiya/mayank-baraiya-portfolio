# Gmail SMTP. Enable 2-Step Verification and generate an App Password in your Google Account.
# Use a fresh App Password; do not use your regular Gmail password.
GMAIL_EMAIL=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
GMAIL_SENDER_NAME=Portfolio Contact
ADMIN_EMAIL=your-admin-email@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
